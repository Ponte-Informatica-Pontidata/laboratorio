# Copie para gestao/.env (NUNCA vai para o git) e preencha o token.
#
# Token fine-grained em https://github.com/settings/personal-access-tokens/new
#   Resource owner: Ponte-Informatica-Pontidata · Repositórios: laboratorio e radar-licitacoes
#   Permissões de repositório: Issues (RW), Pull requests (RW), Contents (R), Metadata (R), Actions (R)
#   Permissões da organização: Projects (RW), Members (R)
GITHUB_PERSONAL_ACCESS_TOKEN=

LAB_ORG=Ponte-Informatica-Pontidata
LAB_REPOS=laboratorio,radar-licitacoes
LAB_TECH_LEAD=pedro-canedo
# Usuário GitHub da estagiária (melhora a leitura das dailies)
LAB_ESTAGIARIA=
# Número do quadro no GitHub Projects (depois de rodar scripts/configurar_quadro.py)
LAB_PROJETO_NUMERO=
